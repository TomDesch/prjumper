<idea-plugin>
    <id>com.github.tomdesch.prjumper</id>
    <name>Prjumper</name>
    <vendor email="tomdescheemaeker@hotmail.com" url="https://github.com/TomDesch">My Github</vendor>
    <description><![CDATA[
        Jump between unviewed PR files using a GitHub token.<br>
        Includes PR Mode navigation and token storage.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService
                serviceImplementation="com.github.tomdesch.prjumper.auth.GitHubTokenService"/>
    </extensions>

    <actions>
        <action id="com.github.tomdesch.prjumper.PRModeAction"
                class="com.github.tomdesch.prjumper.actions.PRModeAction"
                text="PR Mode"
                description="Activate GitHub PR navigation mode">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

</idea-plugin>