<idea-plugin>
    <id>com.github.tomdesch.prjumper</id>
    <name>Prjumper</name>
    <vendor email="tomdescheemaeker@hotmail.com" url="https://github.com/TomDesch">My Github</vendor>
    <description><![CDATA[
        Jump between unviewed PR files using a GitHub token.<br>
        Includes PR Mode navigation and token storage.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService
                serviceImplementation="com.github.tomdesch.prjumper.auth.GitHubTokenService"/>

        <statusBarWidgetFactory
                id="PRJumperStatusWidget"
                implementation="com.github.tomdesch.prjumper.statusbar.PRStatusBarWidgetFactory"/>
    </extensions>

    <actions>
        <!-- PR Mode Action -->
        <action id="com.github.tomdesch.prjumper.PRModeAction"
                class="com.github.tomdesch.prjumper.actions.PRModeAction"
                text="PR Mode"
                description="Activate GitHub PR navigation mode">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <!-- Jump to next unviewed file -->
        <action id="com.github.tomdesch.prjumper.JumpToNextFileAction"
                class="com.github.tomdesch.prjumper.actions.JumpToNextFileAction"
                text="Next Unviewed File"
                description="Jump to next unviewed PR file">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl 5"/>
        </action>
    </actions>
</idea-plugin>